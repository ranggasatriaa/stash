# ---------------------------------------------------------------------------
# Stash environment. Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------
APP_NAME=Stash
APP_ENV=local                 # production on the VPS
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000 # https://stash.example.com in production
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Default display timezone for new users (storage is always UTC).
STASH_DISPLAY_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # warning or error in production

# --- PostgreSQL (canonical database; required, SQLite is not supported) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1             # "postgres" inside Docker Compose
DB_PORT=5432
DB_DATABASE=stash
DB_USERNAME=stash
DB_PASSWORD=change-me

# --- Sessions / cookies ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true in production (HTTPS only)
SESSION_SAME_SITE=lax

# --- Redis (queues + cache; never authoritative storage) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1          # "redis" inside Docker Compose
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=300
CACHE_STORE=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Private file storage ---
STASH_STORAGE_DISK=stash
# STASH_STORAGE_ROOT=/var/www/html/storage/app/private/stash

# --- Upload limits ---
STASH_UPLOAD_MAX_BYTES=10485760      # 10 MiB per original
STASH_UPLOAD_MAX_PIXELS=40000000     # 40 megapixels
STASH_IMAGE_DRIVER=gd                # gd | imagick

# --- Metadata fetcher (SSRF-hardened) ---
STASH_FETCH_CONNECT_TIMEOUT=5
STASH_FETCH_TIMEOUT=10
STASH_FETCH_MAX_HTML_BYTES=2097152
STASH_FETCH_MAX_IMAGE_BYTES=5242880
STASH_FETCH_MAX_REDIRECTS=5
STASH_FETCH_ALLOWED_PORTS=80,443,8080,8443

# --- API tokens ---
SANCTUM_TOKEN_PREFIX=stash_

# --- Optional DeepSeek summaries (disabled unless all values are set) ---
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verified 2026-11-12 against api-docs.deepseek.com: deepseek-flash, deepseek-v4-pro.
# Re-check the docs before enabling; run `php artisan stash:ai-check`.
DEEPSEEK_MODEL=
AI_MONTHLY_TOKEN_LIMIT=200000
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=800

# --- Mail (not required; password resets are done with the CLI) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="stash@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Reverse proxy (production behind TLS terminator) ---
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-* headers.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
